# Local development uses SQLite automatically if MySQL is unavailable.
# Set DATABASE_DRIVER=mysql in production and provide the hosted MySQL settings below.
DATABASE_DRIVER=mysql
ALLOW_SQLITE_FALLBACK=true
# For MongoDB Atlas deployments, set DATABASE_DRIVER=mongodb and configure MONGODB_URI.
MONGODB_URI=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=study_tracker
MYSQL_PASSWORD=
MYSQL_DATABASE=iitm_study_tracker
# Hosted MySQL: paste the provider CA certificate, with newlines escaped as \\n.
MYSQL_SSL_CA=
GOOGLE_CLIENT_ID=
# Optional Notion goal mirror. Share this page with the integration before setup.
NOTION_TOKEN=
# This Study Goals database was created in the connected Notion workspace.
NOTION_GOALS_DATABASE_ID=fab18750-36f8-4ea5-8835-4498f938607a
# Only needed if the app should create a different database automatically.
NOTION_PARENT_PAGE_ID=
# Comma-separated email addresses allowed to use the admin panel.
ADMIN_EMAILS=
APP_ORIGIN=http://localhost:3000
PORT=3001
# Only for explicitly local SQLite development:
# DATABASE_DRIVER=sqlite
